# Server Configuration
PORT=8080
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace username, password, and cluster details with your MongoDB Atlas details.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mydb?retryWrites=true&w=majority&appName=Cluster0

